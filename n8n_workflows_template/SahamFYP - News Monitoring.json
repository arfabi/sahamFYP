      "parameters": {
        "jsCode": "const slide = $input.item.json;\nconst image = $('Generate Naskah').first().json.image;\n\nfunction buildSlideHtml(slide, image) {\n  const accent = slide.accent || '#F2A93B';\n  let iconSvg = '';\n  \n  if (slide.template === 'cta') {\n    iconSvg = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"80\" height=\"80\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"' + accent + '\" stroke-width=\"2\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"/></svg>';\n  } else if (slide.template === 'pros') {\n    iconSvg = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4CAF7D\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></svg>';\n  } else if (slide.template === 'cons') {\n    iconSvg = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#E4572E\" stroke-width=\"2\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"/></svg>';\n  } else {\n    iconSvg = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"80\" height=\"80\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"' + accent + '\" stroke-width=\"2\"><polyline points=\"22 7 13.5 15.5 8.5 10.5 2 17\"/><polyline points=\"16 7 22 7 22 13\"/></svg>';\n  }\n\n  let content = '';\n  \n  if (slide.template === 'cover') {\n    content = '<div class=\"slide\" style=\"background:linear-gradient(135deg,#14182B 0%,#1E2A4A 100%)\">' +\n      (image ? '<img class=\"illustration\" src=\"' + image + '\" alt=\"\">' : '') +\n      '<h1 class=\"title\" style=\"color:' + accent + '\">' + (slide.title || '') + '</h1>' +\n      '<p class=\"description\">' + (slide.description || '') + '</p>' +\n      '</div>';\n  } else if (slide.template === 'cta') {\n    content = '<div class=\"slide\">' +\n      '<div class=\"icon-container\">' + iconSvg + '</div>' +\n      '<h1 class=\"title\" style=\"color:' + accent + '\">' + (slide.title || '') + '</h1>' +\n      '<p class=\"description\">' + (slide.description || '') + '</p>' +\n      (slide.disclaimer ? '<div class=\"disclaimer\">' + slide.disclaimer + '</div>' : '') +\n      '</div>';\n  } else {\n    content = '<div class=\"slide\">' +\n      '<div class=\"icon-container\">' + iconSvg + '</div>' +\n      '<h1 class=\"title\" style=\"color:' + accent + '\">' + (slide.title || '') + '</h1>' +\n      '<p class=\"description\">' + (slide.description || '') + '</p>' +\n      '</div>';\n  }\n\n  return '<!DOCTYPE html><html><head><style>' +\n    '*{margin:0;padding:0;box-sizing:border-box}' +\n    'body{width:1080px;height:1080px;font-family:Arial,sans-serif;background:#14182B;color:#FFF;overflow:hidden}' +\n    '.slide{width:1080px;height:1080px;padding:60px;display:flex;flex-direction:column;justify-content:center}' +\n    '.title{font-size:56px;font-weight:800;line-height:1.2;margin-bottom:24px}' +\n    '.description{font-size:32px;line-height:1.5;opacity:.9}' +\n    '.icon-container{position:absolute;top:60px;right:60px}' +\n    '.illustration{width:100%;height:400px;object-fit:cover;border-radius:16px;margin-bottom:32px}' +\n    '.disclaimer{font-size:20px;opacity:.7;margin-top:24px;padding:16px 24px;background:rgba(255,255,255,.1);border-radius:12px}' +\n    '</style></head><body>' + content + '</body></html>';\n}\n\nreturn {\n  json: {\n    html: buildSlideHtml(slide, image),\n    slideIndex: $item.index,\n    template: slide.template,\n  }\n};\n"
      },
