# ========================================
# SahamFYP Environment Variables
# ========================================
# Copy file ini ke .env.local dan isi dengan API keys Anda
# JANGAN commit .env.local ke git!

# ========================================
# Gemini AI (Google AI Studio)
# ========================================
# Dapatkan di: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# Sectors.app API
# ========================================
# Dapatkan di: https://sectors.app
VITE_SECTORS_API_KEY=your_sectors_api_key_here

# ========================================
# Supabase
# ========================================
# Dapatkan di: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ========================================
# Cloudinary
# ========================================
# Dapatkan di: https://cloudinary.com → Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# ========================================
# Repliz (Instagram + TikTok Publishing)
# ========================================
# Dapatkan di: https://repliz.com → Settings → API
VITE_REPLIZ_ACCESS_KEY=your_repliz_access_key_here
VITE_REPLIZ_SECRET_KEY=your_repliz_secret_key_here
VITE_REPLIZ_ACCOUNT_ID=your_repliz_account_id_here

# ========================================
# N8N API (server-side, non-VITE)
# Gunakan di API endpoints untuk n8n integration
# ========================================
# Generate random token: openssl rand -hex 32
N8N_API_KEY=your_random_token_here

# ========================================
# Server-side Supabase service role key (for api/*.ts)
# ========================================
# Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
