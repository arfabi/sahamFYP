# ========================================
# SahamFYP Environment Variables
# ========================================
# Copy file ini ke .env.local dan isi dengan API keys Anda
# JANGAN commit .env.local ke git!

# ========================================
# Gemini AI (Google AI Studio)
# ========================================
# Dapatkan di: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# Sectors.app API
# ========================================
# Dapatkan di: https://sectors.app
SECTORS_API_KEY=your_sectors_api_key_here

# ========================================
# Supabase
# ========================================
# Dapatkan di: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ========================================
# Cloudinary
# ========================================
# Dapatkan di: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# ========================================
# Repliz (Instagram + TikTok Publishing)
# ========================================
# Dapatkan di: https://repliz.com → Settings → API
REPLIZ_ACCESS_KEY=your_repliz_access_key_here
REPLIZ_SECRET_KEY=your_repliz_secret_key_here
REPLIZ_ACCOUNT_ID=your_repliz_account_id_here

# ========================================
# N8N API Key (server-side, untuk API auth)
# ========================================
# Generate: openssl rand -hex 32
N8N_API_KEY=your_random_token_here

# ========================================
# FRONTEND ENV VARS (VITE_ prefix)
# ========================================
# ⚠️ Vite HANYA expose env vars dengan prefix "VITE_" ke client code (build time).
# Set VITE_ duplicate di Vercel Settings → Env Variables juga biar frontend build jalan!
#
# 💡 DEDUP TIP: di Vercel cukup set EEN KEER de non-prefixed keys hierboven.
# Build command `node scripts/sync-env.mjs && npm run build` auto-generates
# de VITE_ duplicates in `.env.local` tijdens build (zie scripts/sync-env.mjs).
# Lokaal: `npm run sync:env` doet hetzelfde voor jouw `.env.local`.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_SECTORS_API_KEY=your_sectors_api_key_here
VITE_REPLIZ_ACCESS_KEY=your_repliz_access_key_here
VITE_REPLIZ_SECRET_KEY=your_repliz_secret_key_here
VITE_REPLIZ_ACCOUNT_ID=your_repliz_account_id_here
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here
VITE_N8N_API_KEY=your_random_token_here
