# ========================================
# SahamFYP Environment Variables
# ========================================
# Copy file ini ke .env.local dan isi dengan API keys Anda
# JANGAN commit .env.local ke git!

# ========================================
# LLM — OpenAI-compatible (Sumopod)
# ========================================
# Dapatkan di: https://ai.sumopod.com → Dashboard → API Keys
SUMOPOD_API_KEY=sk-your_sumopod_api_key_here
# Opsional (kalau tidak diisi, dipakai default di api/_lib/llm.ts):
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=gemini/gemini-3.1-flash-lite

# ========================================
# Sectors.app API
# ========================================
# Dapatkan di: https://sectors.app
SECTORS_API_KEY=your_sectors_api_key_here

# ========================================
# Supabase
# ========================================
# Dapatkan di: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ========================================
# Cloudinary
# ========================================
# Dapatkan di: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# ========================================
# Repliz (Instagram + TikTok Publishing)
# ========================================
# Dapatkan di: https://repliz.com → Settings → API
REPLIZ_ACCESS_KEY=your_repliz_access_key_here
REPLIZ_SECRET_KEY=your_repliz_secret_key_here
REPLIZ_ACCOUNT_ID=your_repliz_account_id_here
# Opsional: TikTok account ID (jika beda dari Instagram)
# REPLIZ_TIKTOK_ACCOUNT_ID=your_repliz_tiktok_account_id_here

# ========================================
# N8N API Key (server-side, untuk API auth)
# ========================================
# Generate: openssl rand -hex 32
# Dipakai untuk autentikasi webhook calls dari n8n ke endpoint:
# /api/enrich, /api/generate, /api/posts, /api/publish, /api/llm
N8N_API_KEY=your_random_token_here

# ========================================
# Browserless.io (untuk render slides di n8n)
# ========================================
# Dapatkan di: https://www.browserless.io → Dashboard → API Key
# Gratis: 1,000 units/bulan (~60-125 posts/bulan)
# Dipakai di n8n untuk screenshot slides ke PNG
BROWSERLESS_IO_KEY=your_browserless_api_key_here

# ========================================
# Telegram Bot (opsional)
# ========================================
# Dapatkan di: https://core.telegram.org/bots
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# ========================================
# CATATAN: FRONTEND ENV VARS (VITE_ prefix)
# ========================================
# Vite HANYA expose env vars dengan prefix "VITE_" ke client code (build time).
# JANGAN tambahkan VITE_ keys secara manual di sini!
#
# 💡 MEKANISME DEDUP:
# - File `scripts/sync-env.mjs` akan auto-generate VITE_ duplicates dari
#   non-prefixed keys di atas saat build/dev.
# - Vercel: build command = `node scripts/sync-env.mjs && npm run build`
# - Lokal: jalankan `npm run sync:env` (otomatis via predev/prebuild hooks)
# - Lihat README.md bagian "Environment Variables" untuk detailnya.
