# ========================================
# SahamFYP Environment Variables (.env.example)
# ========================================
# Salin file ini menjadi .env.local untuk development lokal:
#   cp .env.example .env.local
# JANGAN PERNAH meng-commit file .env.local ke Git!

# ========================================
# 1. LLM — OpenAI-Compatible (Sumopod / Gemini)
# ========================================
# Digunakan untuk validasi scoring katalis, sentiment classification, dan generate naskah carousel.
# Dapatkan di: https://ai.sumopod.com → Dashboard → API Keys
SUMOPOD_API_KEY="sk-your_sumopod_api_key_here"
SUMOPOD_BASE_URL="https://ai.sumopod.com/v1"
SUMOPOD_MODEL="gemini/gemini-3.1-flash-lite"

# ========================================
# 2. Sectors.app REST API
# ========================================
# Digunakan untuk data finansial pasar saham IHSG, top movers, market caps, dan valuasi sektoral.
# Dapatkan di: https://sectors.app
SECTORS_API_KEY="your_sectors_api_key_here"

# ========================================
# 3. Supabase (Database & Storage)
# ========================================
# Dapatkan di: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key_here"

# ========================================
# 4. Repliz API (Multi-Platform Social Media Scheduler)
# ========================================
# Digunakan untuk publish & schedule ke Instagram, TikTok, Threads, Facebook.
# Dapatkan di: https://repliz.com → Settings → API
REPLIZ_ACCESS_KEY="your_repliz_access_key_here"
REPLIZ_SECRET_KEY="your_repliz_secret_key_here"
REPLIZ_ACCOUNT_ID="your_repliz_account_id_here"
# Opsional: Account ID khusus TikTok jika berbeda dari akun utama
# REPLIZ_TIKTOK_ACCOUNT_ID="your_repliz_tiktok_account_id_here"

# ========================================
# 5. N8N Webhook API Key
# ========================================
# Digunakan untuk autentikasi keamanan panggilan webhook/API antara n8n dan serverless backend (/api/*).
# Anda bisa mengisi string token rahasia acak atau JWT token.
N8N_API_KEY="your_n8n_api_key_or_secret_token_here"

# ========================================
# 6. Browserless.io (Headless Chrome Renderer)
# ========================================
# Digunakan di workflow n8n untuk me-render kode HTML slide menjadi gambar carousel beresolusi tinggi (1080x1350 JPEG/PNG).
# Dapatkan di: https://www.browserless.io → Dashboard → API Key
BROWSERLESS_IO_KEY="your_browserless_api_key_here"

# ========================================
# 7. Telegram Bot
# ========================================
# Digunakan untuk distribusi postingan ke channel Telegram (https://t.me/sahamfyp) & broadcast notifikasi eksekusi automasi.
# Buat bot dan dapatkan token dari @BotFather di Telegram: https://core.telegram.org/bots
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Opsional: Chat ID untuk notifikasi langsung (personal / grup monitoring)
# TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# ========================================
# CATATAN: SINKRONISASI OTOMATIS FRONTEND (VITE_*)
# ========================================
# Vite HANYA mengekspos variabel lingkungan dengan awalan "VITE_" ke kode client di browser.
# Skrip `scripts/sync-env.mjs` akan secara OTOMATIS menduplikasi variabel di atas ke versi "VITE_*"
# saat Anda menjalankan `npm run dev` atau `npm run build`:
#
#   SUPABASE_URL         → VITE_SUPABASE_URL
#   SUPABASE_ANON_KEY    → VITE_SUPABASE_ANON_KEY
#   SUMOPOD_API_KEY      → VITE_SUMOPOD_API_KEY
#   SUMOPOD_BASE_URL     → VITE_LLM_BASE_URL
#   SUMOPOD_MODEL        → VITE_LLM_MODEL
#   SECTORS_API_KEY      → VITE_SECTORS_API_KEY
#   REPLIZ_ACCESS_KEY    → VITE_REPLIZ_ACCESS_KEY
#   REPLIZ_SECRET_KEY    → VITE_REPLIZ_SECRET_KEY
#   REPLIZ_ACCOUNT_ID    → VITE_REPLIZ_ACCOUNT_ID
#   N8N_API_KEY          → VITE_N8N_API_KEY
#
# Anda cukup mengisi variabel non-prefixed di atas, sistem akan menangani sisanya secara otomatis.
