{
    "outputDirectory":  "dist",
    "buildCommand":  "npm run build",
    "routes":  [
                   {
                       "src":  "/api/(.*)",
                       "continue":  true
                   },
                   {
                       "src":  "/(.*)",
                       "dest":  "/index.html"
                   }
               ],
    "version":  2
}