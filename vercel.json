{
    "outputDirectory":  "dist",
    "buildCommand":  "npm run build",
    "builds":  [
                   {
                       "src":  "api/**/*.ts",
                       "use":  "@vercel/node"
                   },
                   {
                       "src":  "**/*",
                       "use":  "@vercel/static"
                   }
               ],
    "version":  2,
    "rewrites":  [
                     {
                         "destination":  "/api",
                         "source":  "/api/(.*)"
                     }
                 ]
}